{
  "name": "studyos",
  "private": true,
  "version": "1.0.0",
  "description": "StudyOS local-first student productivity and study management app",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:desktop": "npm run build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/server.mjs",
    "dist:win": "npm run build:desktop && electron-builder --win nsis",
    "preview": "vite preview",
    "clean": "node -e \"for (const dir of ['dist', 'dist-electron', 'release', 'release-jeeos']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.jeeos.desktop",
    "productName": "JEE OS",
    "executableName": "StudyOS",
    "artifactName": "JEE-OS-Setup-${version}.${ext}",
    "directories": {
      "output": "release-jeeos"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JEE OS"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "katex": "^0.19.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  }
}
